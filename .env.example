# Passcode for the /admin dashboard
ADMIN_PASSCODE=1234

# Extra salt for the admin session cookie
ADMIN_SECRET=change-me-to-a-long-random-string

# Postgres connection string. Set it and the app stores everything in Postgres,
# creating its tables and seed content on first use — there is no migration to
# run. Leave it unset and the app falls back to the JSON store in .data/db.json,
# so local development works without a database.
#
# Supabase: Project settings -> Database -> Connection string -> URI.
# Use the *transaction pooler* (port 6543) on Vercel, not the direct 5432 host.
# DATABASE_URL=postgresql://postgres.abcdefgh:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
